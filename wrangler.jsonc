{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifeos-v2",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "ATTACHMENTS",
      "service": "lifeos-attachments"
    }
{
  "previews": {
    // ...
    "d1_databases": [
      {
        "binding": "lifeos-plaid-sandbox",
        "database_id": "6c1ca4a8-68d3-4d81-9ef7-24eed5642962"
      }
    ],
    // ...
  }
}
  ],
  "observability": { "enabled": true }
}
