{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifeos-v2",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "ATTACHMENTS",
      "service": "lifeos-attachments"
    }
  ],
  "observability": { "enabled": true }
}
